# Vercel Deployment Exclusions
# Prevents non-runtime scripts, docs, and build cache from consuming deployment storage

.git
.github
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Setup and generator scripts not required at runtime
setup-all-routes.js
setup-pages.js
generate-metadata-db.js

# Internal design, strategy, and planning documentation
seo_brand_domination_strategy.md
task.md
implementation_plan.md
walkthrough.md
CLAUDE.md

# Build artifacts and caches
.cache/
coverage/
*.tsbuildinfo

# Prettier and lint configs (not needed in production bundle)
.prettierrc
.lintstagedrc.json
commitlint.config.js
